# Токен от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

DB_PATH=data/bot.db
TIMEZONE=Asia/Almaty
CURRENCY=₸

# Рабочее время и перерывы (перерывы через запятую: 13:00-14:00,17:00-17:15).
# Это общий график. Мастера (необязательно) добавляются в боте: /addmaster Имя | Telegram ID | часы | дни | перерывы;
# незаданные поля мастера берутся отсюда. Пока активных мастеров меньше двух, шаг выбора мастера не показывается.
WORK_START=10:00
WORK_END=20:00
BREAKS=13:00-14:00
# Рабочие дни: 1=Пн ... 7=Вс
WORK_DAYS=1,2,3,4,5,6

# Шаг сетки слотов, глубина записи и минимальное время до записи
SLOT_STEP_MINUTES=30
DAYS_AHEAD=14
MIN_LEAD_MINUTES=60

# За сколько минут напоминать клиенту (0 — выключить)
REMIND_BEFORE_MINUTES=120
# Максимум активных записей на одного клиента
MAX_ACTIVE_PER_USER=3

# Демо-режим: клиент после заявки получает копию карточки владельца и может управлять своей записью;
# если мастеров нет, создаются два демо-мастера
DEMO_MODE=0

# Язык интерфейса: ru или en (для английской версии запускайте отдельный экземпляр со своим токеном)
BOT_LANG=ru
